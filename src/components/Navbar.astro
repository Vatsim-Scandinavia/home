---
import "./site-chrome.css";
import { Astronav, MenuItems } from "astro-navbar";
import ThemeToggle from "./ThemeToggle"
import Navigation from "./Navigation";
import MobileMenu from "./MobileMenu";
const { overlay = false } = Astro.props;
---
<header class:list={["site-nav top-0 z-50 w-full", overlay ? "site-nav--overlay" : "sticky"]} data-overlay-nav={overlay ? "" : undefined}>
    <Astronav>
        <div class="site-nav-inner">
            <div class="site-nav-main">
                <a href="/" class="flex items-center space-x-2 transition-opacity hover:opacity-80">
                    <!-- Logo for light mode (dark logo) -->
                    <img 
                        width="250" 
                        height="auto"
                        src="/img/logos/negative.svg"
                        alt="VATSIM Scandinavia logo" 
                        class="h-18 w-auto dark:hidden"
                    >
                    <!-- Logo for dark mode (white logo) -->
                    <img 
                        width="250" 
                        height="auto"
                        src="/img/logos/negative.svg" 
                        alt="VATSIM Scandinavia logo" 
                        class="h-18 w-auto hidden dark:block"
                    >
                </a>
                <MenuItems class="hidden lg:flex lg:items-center text-white">
                    <Navigation client:load/>
                </MenuItems>
            </div>
            <div class="flex items-center gap-2 text-white">
                <div class="hidden lg:block">
                    <ThemeToggle client:only="react"/>
                </div>
                <div class="block lg:hidden">
                    <MobileMenu client:only="react" />
                </div>
            </div>
        </div>
    </Astronav>
</header>

<script>
    // Over the hero the nav starts transparent and turns solid once the page scrolls.
    const nav = document.querySelector<HTMLElement>('[data-overlay-nav]');
    if (nav) {
        const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('pageshow', update);
    }
</script>
