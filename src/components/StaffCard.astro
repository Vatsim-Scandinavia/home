---
import AvailabilityDecode from "./AvailabilityDecode";

interface Props {
    member: {
        cid: number;
        name: string;
        title: string;
        email: string;
        country?: string;
        avatar?: string;
        availability?: string;
    };
}

const { member } = Astro.props;
---

<article class="staff-member">
  <div class="staff-avatar">
    <img src={member.avatar || "/img/avatar.jpg"} alt="" width="92" height="92" loading="lazy" />
    {member.availability && <span class="staff-availability"><AvailabilityDecode Availability={member.availability} variant="badge" /></span>}
  </div>
  <div class="staff-member-info">
    
    <p class="staff-member-name">{member.name}{member.country && <img src={`/img/icons/${member.country}.svg`} alt={member.country} width="16" height="16" loading="lazy" />}</p>
    <p class="staff-member-role">{member.title}</p>
    <div class="staff-contact-row">
      {member.cid > 0 && <p class="staff-cid">CID {member.cid}</p>}
      {member.email && <a class="staff-email" href={`mailto:${member.email}`} aria-label={`Email ${member.name}, ${member.title}`} title={`Email ${member.name}`}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>}
    </div>
  </div>
</article>
