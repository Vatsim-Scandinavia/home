---
import Events from "./Events";
import type { EventCard, EventsResponse, VatscaEvent } from "@/interfaces/Event";
import { toEventCards } from "@/lib/events";

// Fetched here rather than in the island so the list is server-rendered. index.astro
// is prerendered, so this component is used with server:defer to keep the data fresh
// per request instead of baking it in at build time.
let events: EventCard[] = [];

try {
    const upcoming: VatscaEvent[] = [];
    let nextPage: string | null = "https://events.vatsim-scandinavia.org/api/v1/events?per_page=100";

    do {
        const response = await fetch(nextPage, { headers: { Accept: "application/json" } });

        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        const page: EventsResponse = await response.json();
        upcoming.push(...page.data);
        nextPage = page.links.next;
    } while (nextPage);

    // Select the next active occurrence before sorting: the API also includes
    // past dates and cancellations for recurring events.
    events = toEventCards(upcoming).slice(0, 9);
} catch (error) {
    console.error("Error fetching events:", error);
}
---
{/* Nothing to slide through if the fetch failed: rendering the island anyway leaves
    an empty slider and a pair of orphaned arrows sitting in the card. */}
{events.length > 0 && <Events events={events} client:load />}
{events.length === 0 && <p class="booking-message">No events available right now. Visit the events calendar for the latest updates.</p>}
