---
import "./site-chrome.css";
import { Astronav, MenuItems } from "astro-navbar";
import ThemeToggle from "./ThemeToggle"
import Navigation from "./Navigation";
import MobileMenu from "./MobileMenu";
const { revealOnScroll = false } = Astro.props;
---
<header class:list={["site-nav top-0 z-50 w-full", revealOnScroll ? "scroll-nav" : "sticky"]} data-scroll-nav={revealOnScroll ? "" : undefined} inert={revealOnScroll}>
    <Astronav>
        <div class="site-nav-inner">
            <div class="site-nav-main">
                <a href="/" class="flex items-center space-x-2 transition-opacity hover:opacity-80">
                    <!-- Logo for light mode (dark logo) -->
                    <img 
                        width="150" 
                        height="auto"
                        src="/img/logos/negative.svg"
                        alt="VATSIM Scandinavia logo" 
                        class="h-14 w-auto dark:hidden"
                    >
                    <!-- Logo for dark mode (white logo) -->
                    <img 
                        width="150" 
                        height="auto"
                        src="/img/logos/negative.svg" 
                        alt="VATSIM Scandinavia logo" 
                        class="h-14 w-auto hidden dark:block"
                    >
                </a>
                <MenuItems class="hidden lg:flex lg:items-center text-white">
                    <Navigation client:load/>
                </MenuItems>
            </div>
            <div class="flex items-center gap-2 text-white">
                <div class="hidden lg:block">
                    <ThemeToggle client:only="react"/>
                </div>
                <div class="block lg:hidden">
                    <MobileMenu client:only="react" />
                </div>
            </div>
        </div>
    </Astronav>
</header>

<style>
    .scroll-nav {
        position: fixed;
        inset-inline: 0;
        transform: translateY(-100%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: transform 200ms ease, opacity 200ms ease, visibility 200ms;
    }

    .scroll-nav.is-visible {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    @media (prefers-reduced-motion: reduce) {
        .scroll-nav { transition: none; }
    }
</style>

<script>
    const nav = document.querySelector<HTMLElement>('[data-scroll-nav]');
    if (nav) {
        const updateNavigation = () => {
            const visible = window.scrollY > 0;
            nav.classList.toggle('is-visible', visible);
            nav.inert = !visible;
        };
        updateNavigation();
        window.addEventListener('scroll', updateNavigation, { passive: true });
        window.addEventListener('pageshow', updateNavigation);
    }
</script>
