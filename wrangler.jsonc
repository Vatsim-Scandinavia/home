{
  // Astro + @astrojs/cloudflare (on-demand / server islands).
  // https://developers.cloudflare.com/workers/framework-guides/web-apps/astro/
  // Adapter v14+ builds through @cloudflare/vite-plugin and ships its own Worker
  // entrypoint; `main` must point at that, not at the build output.
  "name": "home",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // `assets.directory` is now managed by @cloudflare/vite-plugin.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
}
