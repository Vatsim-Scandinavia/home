---
export const prerender = true;

import Layout from "../layout/Layout.astro";
import Hero from "../components/Hero.astro";
import Bookings from "../components/Bookings.astro";
import Events from "../components/Events.astro";
import News from "../components/News.astro";
import "../components/booking-board.css";
import "../components/announcements.css";
import "../components/home-panels.css";
import "../components/events-board.css";
---

<Layout SiteTitle="VATSIM Scandinavia">
  <Hero slot="hero" />

  <main id="bookings" class="home">
    <div class="home-panels">
      <div class="home-main">
        <section class="announcements-panel" aria-labelledby="announcements-title">
          <div class="booking-board-heading announcements-heading">
            <h2 id="announcements-title">Latest announcements</h2>
            <a href="https://forum.vatsim-scandinavia.org/t/announcements" target="_blank" rel="noopener noreferrer">All announcements <span aria-hidden="true">↗</span></a>
          </div>
          <News server:defer>
            <div slot="fallback" aria-label="Loading announcements" aria-busy="true" class="announcements-list">
              {[1, 2, 3, 4].map(() => <div class="announcement-placeholder"><span></span><span></span></div>)}
            </div>
          </News>
        </section>

        <section class="booking-board events-board" aria-labelledby="events-title">
          <div class="booking-board-heading">
            <h2 id="events-title">Events</h2>
          </div>
          <div class="events-content">
            <Events server:defer>
              <div slot="fallback" aria-label="Loading events" aria-busy="true">
                {[1, 2].map(() => (
                  <div class="event-preview event-placeholder">
                    <div class="event-preview-image"></div>
                    <div><span></span><span></span><span></span></div>
                  </div>
                ))}
              </div>
            </Events>
          </div>
          <a class="booking-footer" href="https://events.vatsim-scandinavia.org/" target="_blank" rel="noopener noreferrer">View all events <span aria-hidden="true">↗</span></a>
        </section>
      </div>

      <div class="home-aside">
        <div class="live-atc-panel">
          <Bookings />
        </div>

        <div class="support-panels">
          <section class="booking-board support-card" aria-labelledby="donations-title">
            <div class="booking-board-heading">
              <h2 id="donations-title">Donations</h2>
            </div>
            <p class="support-copy">Help keep our skies connected. Your donations support the infrastructure and services our community relies on.</p>
            <a class="booking-footer" href="/about/donations">Support the community <span aria-hidden="true">→</span></a>
          </section>
          <section class="booking-board support-card" aria-labelledby="feedback-title">
            <div class="booking-board-heading">
              <h2 id="feedback-title">Feedback</h2>
            </div>
            <p class="support-copy">Had a great flight, or have a suggestion? Share your experience to help our controllers improve.</p>
            <a class="booking-footer" href="https://cc.vatsim-scandinavia.org/feedback" target="_blank" rel="noopener noreferrer">Leave feedback <span aria-hidden="true">↗</span></a>
          </section>
        </div>
      </div>
    </div>
  </main>
</Layout>
